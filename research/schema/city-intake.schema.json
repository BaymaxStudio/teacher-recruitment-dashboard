{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/city-intake.schema.json",
  "title": "十四城官方学校池资料包",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "isTemplate",
    "batchId",
    "province",
    "city",
    "researchedAt",
    "researcher",
    "sources",
    "privateSchools",
    "publicTargets",
    "coverageGaps",
    "unresolvedAliases",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "isTemplate": { "type": "boolean" },
    "batchId": { "type": "string", "minLength": 1 },
    "province": { "enum": ["广东", "浙江", "江苏"] },
    "city": {
      "enum": ["广州", "深圳", "佛山", "珠海", "惠州", "东莞", "杭州", "宁波", "温州", "嘉兴", "绍兴", "南京", "苏州", "无锡"]
    },
    "researchedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "researcher": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "privateSchools": {
      "type": "array",
      "items": { "$ref": "#/$defs/privateSchool" }
    },
    "publicTargets": {
      "type": "array",
      "items": { "$ref": "#/$defs/publicTarget" }
    },
    "coverageGaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverageGap" }
    },
    "unresolvedAliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolvedAlias" }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "publisher", "sourceLevel", "sourceType", "publishedAt", "accessedAt", "accessState", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^src-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "publisher": { "type": "string", "minLength": 1 },
        "sourceLevel": { "enum": ["A1_government", "A2_school_official"] },
        "sourceType": { "enum": ["学校名单", "教育部门说明", "学校主页", "公办目标依据"] },
        "publishedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "accessedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "accessState": { "enum": ["ok", "qr_only", "login_required", "blocked", "dead"] },
        "note": { "type": "string" }
      }
    },
    "privateSchool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "officialName", "district", "schoolStages", "ownership", "officialPoolEvidenceIds", "aliasNames", "activeState", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^school-[a-z0-9-]+$" },
        "officialName": { "type": "string", "minLength": 1 },
        "district": { "type": "string", "minLength": 1 },
        "schoolStages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["初中", "高中"] } },
        "ownership": { "const": "民办" },
        "officialPoolEvidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "aliasNames": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "activeState": { "enum": ["正常办学", "更名", "停办", "待确认"] },
        "note": { "type": "string" }
      }
    },
    "publicTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "officialName", "district", "schoolStages", "targetTier", "targetReason", "evidenceIds", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^public-[a-z0-9-]+$" },
        "officialName": { "type": "string", "minLength": 1 },
        "district": { "type": "string", "minLength": 1 },
        "schoolStages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["高中"] } },
        "targetTier": { "enum": ["核心", "扩展"] },
        "targetReason": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "coverageGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "description", "evidenceIds", "nextAction"],
      "properties": {
        "scope": { "enum": ["private_school_pool", "public_target_pool", "district", "source_access"] },
        "description": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "nextAction": { "type": "string", "minLength": 1 }
      }
    },
    "unresolvedAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nameA", "nameB", "reasonUnresolved", "evidenceIds"],
      "properties": {
        "nameA": { "type": "string", "minLength": 1 },
        "nameB": { "type": "string", "minLength": 1 },
        "reasonUnresolved": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
